# Copy to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project settings → API) ---
# Browser-safe: the public URL and anon key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Server only: never expose the service role key to the browser
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- AI matching and aura (console.anthropic.com → API keys) ---
# Without it, Rareness falls back to a simpler rule-based matcher.
ANTHROPIC_API_KEY=

# --- One-time access fee (dashboard.stripe.com) ---
# After sign-up and the aura quick test, members pay once to unlock the app.
# Set PAYWALL=off only to let people in for free (e.g. while you test it yourself).
PAYWALL=on
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The fee: 500 = $5.00. Leave STRIPE_PRICE_ID empty to use these; or set a one-time Price id (price_...) from Stripe instead.
ACCESS_PRICE_CENTS=500
ACCESS_CURRENCY=usd
STRIPE_PRICE_ID=
# Shown on the button, e.g. "$5"
PRICE_LABEL=$5

# --- App ---
# Your public address, used for Stripe redirects (e.g. https://rareness.vercel.app)
APP_URL=
# Any long random string; Vercel sends it with the daily matching job
CRON_SECRET=

# Optional: only these emails can sign in (comma-separated). Empty = anyone with the link.
TESTER_EMAILS=

# Emails that can open the dashboard at /admin (comma-separated)
ADMIN_EMAILS=
