# Copy to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project settings → API) ---
# Browser-safe: the public URL and anon key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Server only: never expose the service role key to the browser
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- AI matching and aura (console.anthropic.com → API keys) ---
# Without it, Rareness falls back to a simpler rule-based matcher.
ANTHROPIC_API_KEY=

# --- Membership (dashboard.stripe.com) ---
# "on" requires an active subscription to use the app; "off" keeps it free (e.g. for the first testers)
PAYWALL=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The recurring Price to sell (Products → your product → price id, starts with price_)
STRIPE_PRICE_ID=
# Shown on the membership button, e.g. "€9.99 a month"
PRICE_LABEL=
# Optional free trial length in days
STRIPE_TRIAL_DAYS=0

# --- App ---
# Your public address, used for Stripe redirects (e.g. https://rareness.vercel.app)
APP_URL=
# Any long random string; Vercel sends it with the daily matching job
CRON_SECRET=
